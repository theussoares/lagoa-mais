# Painel da rede (apps/admin). Nada daqui vai para o navegador, fora o NUXT_PUBLIC_*.
NUXT_API_BASE_URL=http://localhost:3333/v1
NUXT_SUPABASE_URL=
NUXT_SUPABASE_ANON_KEY=
# Turnstile: chaves de teste do Cloudflare (sempre passam). Em produção, as do widget de admin.lagoamais.com.br.
NUXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
NUXT_TURNSTILE_SECRET=1x0000000000000000000000000000000AA
# Mesmo valor de BFF_SHARED_SECRET na API (reserva de tentativa de login). Vazio só em desenvolvimento.
NUXT_BFF_SHARED_SECRET=
NUXT_ALLOWED_ORIGINS=
# Destino do link de "esqueci a senha" (vazio = host do pedido).
NUXT_APP_URL=
