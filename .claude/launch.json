{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "lagoa-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev",
        "--port",
        "3000"
      ],
      "port": 3000
    },
    {
      "name": "lagoa-site",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev:site"
      ],
      "port": 3001
    },
    {
      "name": "lagoa-dev-mock",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev",
        "--port",
        "3010"
      ],
      "port": 3010,
      "env": {
        "NUXT_PUBLIC_MERCHANT_BACKEND": "mock"
      }
    },
    {
      "name": "lagoa-office",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "tools/office/server.mjs"
      ],
      "port": 4545
    },
    {
      "name": "lagoa-admin",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev:admin"
      ],
      "port": 3002,
      "env": {
        "NUXT_PUBLIC_TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
        "NUXT_TURNSTILE_SECRET": "1x0000000000000000000000000000000AA"
      }
    }
  ]
}
